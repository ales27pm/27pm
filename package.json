{
  "name": "27pm-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode github-pages",
    "build:pages:preview": "PAGES_BASE_PATH=/27pm PAGES_HOST=ales27pm.github.io npm run build:pages",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA npm run build && playwright test",
    "test:e2e:fallback": "npm run build && playwright test --grep \"keeps the mail fallback when CRM configuration is absent\"",
    "check:pages": "node scripts/check-pages-build.mjs",
    "check:pages:preview": "PAGES_BASE_PATH=/27pm PAGES_HOST=ales27pm.github.io npm run check:pages",
    "check:release": "npm run build:pages && npm run check:pages",
    "check:public": "node scripts/check-public-site.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
